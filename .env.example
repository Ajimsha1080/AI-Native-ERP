# ==============================================================================
# AI-Native ERP Platform - Environment Configuration (.env.example)
# ==============================================================================
# All configuration variables map directly to packages/config/settings.py.

# ------------------------------------------------------------------------------
# 1. Application & Core Server
# ------------------------------------------------------------------------------
APP_NAME=AI-Native-ERP
APP_VERSION=1.0.0
ENVIRONMENT=development                # Options: development, staging, production, test
ROOT_PATH=                             # Root path prefix if running behind a reverse proxy sub-path
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR, CRITICAL
STRUCTLOG_FORMAT=console               # "console" for development, "json" for production

# ------------------------------------------------------------------------------
# 2. Database & Multi-Tenant Connection Pool
# ------------------------------------------------------------------------------
# Connection string using asyncpg driver for PostgreSQL with Row-Level Security (RLS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_platform

# ------------------------------------------------------------------------------
# 3. Redis Caching & Celery Worker Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Authentication, Cryptography & Token Rotation
# ------------------------------------------------------------------------------
# SECRET_KEY must be a cryptographically secure random string of at least 32 characters in production
SECRET_KEY=change-me-to-a-very-secure-32-character-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_ALGORITHM=argon2         # "argon2" (production recommended) or "bcrypt"

# ------------------------------------------------------------------------------
# 5. Network Security, CORS & Rate Limiting
# ------------------------------------------------------------------------------
# Comma-separated list of allowed HTTP origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60                   # Requests per period in seconds

# ------------------------------------------------------------------------------
# 6. Stripe Enterprise Billing & Webhooks
# ------------------------------------------------------------------------------
# Mandatory outside test/dev environments; webhook signature verified cryptographically
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_PRICE_ID_PRO=price_pro_placeholder
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_placeholder

# Per-Tenant Monthly Token Budgets
MONTHLY_TOKEN_BUDGET_FREE=100000
MONTHLY_TOKEN_BUDGET_PRO=5000000
MONTHLY_TOKEN_BUDGET_ENTERPRISE=50000000

# ------------------------------------------------------------------------------
# 7. LLM Providers & Inference Engines
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai                    # Options: openai, anthropic, google
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-pro
GOOGLE_TEMPERATURE=0.7

# LiteLLM Universal Gateway
LITELLM_MODEL=gpt-4o-mini               # Any model across 100+ providers
LITELLM_FALLBACK_MODELS=claude-3-5-sonnet-20240620,gemini/gemini-1.5-flash
LITELLM_TIMEOUT=30

# ------------------------------------------------------------------------------
# 8. RAG & PostgreSQL pgvector Store
# ------------------------------------------------------------------------------
VECTOR_STORE_TYPE=pgvector             # Supported: pgvector
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 9. Operational & Financial Approval Gates
# ------------------------------------------------------------------------------
# Dual-human manager/owner approval is enforced above medium risk threshold
APPROVAL_LOW_RISK_THRESHOLD=0.0
APPROVAL_MEDIUM_RISK_THRESHOLD=1000.0
APPROVAL_HIGH_RISK_THRESHOLD=10000.0

# ------------------------------------------------------------------------------
# 10. Observability, Metrics & Telemetry
# ------------------------------------------------------------------------------
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=9090
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentic-platform
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# ------------------------------------------------------------------------------
# 11. Error Handling & Security Flags
# ------------------------------------------------------------------------------
# Must be False in production/staging environments
SHOW_ERRORS_IN_BROWSER=False
LOG_ERRORS_TO_FILE=True
ERROR_LOG_FILE_PATH=./logs/error.log

# ------------------------------------------------------------------------------
# 12. LangSmith AI Observability & Agent Tracing
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AI-Native-ERP

# ------------------------------------------------------------------------------
# 13. Text-to-Speech (TTS) & Sarvam AI Indic Engine
# ------------------------------------------------------------------------------
TTS_ENABLED=True
TTS_PROVIDER=edge                       # Options: edge (free neural voices), openai, sarvam
TTS_MODEL=tts-1-hd                      # Options: tts-1-hd (ChatGPT HD Quality), tts-1 (Standard)
TTS_DEFAULT_VOICE=en-US-AriaNeural      # e.g., en-US-AriaNeural, en-IN-NeerjaNeural, sarvam-bulbul-meera
SARVAM_API_KEY=                         # Optional: Sarvam AI API subscription key for Bulbul Indic TTS (https://dashboard.sarvam.ai)


